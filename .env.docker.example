# ── Django (DigitalOcean Docker) ──
SECRET_KEY=change-me-generate-with-python-secrets-token-urlsafe-32
DEBUG=False
DJANGO_SETTINGS_MODULE=config.settings.docker

# ── PostgreSQL (docker-compose service: db) ──
POSTGRES_DB=distage_db
POSTGRES_USER=distage
POSTGRES_PASSWORD=change-me-strong-password
DB_HOST=db
DB_PORT=5432
DATABASE_URL=postgres://distage:change-me-strong-password@db:5432/distage_db

# ── Hosts (додайте IP Droplet) ──
ALLOWED_HOSTS=distageavto.com,www.distageavto.com,distage.com,www.distage.com,127.0.0.1,localhost,web
CSRF_TRUSTED_ORIGINS=https://distageavto.com,https://www.distageavto.com,https://distage.com,https://www.distage.com

# ── HTTPS (після certbot) ──
USE_HTTPS=false
SITE_URL=https://distageavto.com
HTTP_PORT=80

# ── Deploy ──
USE_PROD_COMPOSE=0
SEED_ON_START=0

# ── Email (Gmail SMTP App Password) ──
EMAIL_HOST_USER=distageavto@gmail.com
EMAIL_HOST_PASSWORD=your-app-password-16-chars
DEFAULT_FROM_EMAIL=distageavto@gmail.com
LEAD_NOTIFICATION_EMAIL=distageavto@gmail.com
